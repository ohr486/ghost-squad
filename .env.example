# Ghost Squad - ストーリーボードシステム環境変数テンプレート
# このファイルをコピーして .env を作成し、実際の値を設定してください
#
# 【重要】このファイルはプロジェクト全体の環境変数設定です
# - バックエンド（FastAPI）の設定
# - データベース（PostgreSQL）の設定
# - Docker Composeの設定
# - 外部API（OpenAI、Trello、Jira等）の設定
#
# フロントエンド固有の環境変数は web/.env.example を参照してください

# CORS設定
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# データベース設定
DATABASE_URL=postgresql://gs_user:password@localhost:5432/gs_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=gs_db
DATABASE_USER=gs_user
DATABASE_PASSWORD=password

# OpenAI API設定
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# FastAPI設定
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
SECRET_KEY=your_secret_key_here
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# フロントエンド設定
REACT_APP_API_URL=http://localhost:8000
REACT_APP_ENVIRONMENT=development

# 外部カンバンシステム統合
TRELLO_API_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token
JIRA_API_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your_jira_username
JIRA_API_TOKEN=your_jira_api_token
GITHUB_TOKEN=your_github_personal_access_token

# 通知設定
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_FROM_EMAIL=noreply@gs.local

# ログ設定
LOG_LEVEL=INFO
LOG_FORMAT=json

# セキュリティ設定
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Docker設定
COMPOSE_PROJECT_NAME=gs
POSTGRES_DB=gs_db
POSTGRES_USER=gs_user
POSTGRES_PASSWORD=password

# 開発用設定
PYTHONPATH=/app
PIP_ROOT_USER_ACTION=ignore
