[run]
source = .
omit =
    tests/*
    __pycache__/*
    .pytest_cache/*
    htmlcov/*
    venv/*
    */site-packages/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
